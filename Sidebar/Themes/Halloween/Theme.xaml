	<!-- ===== SidebarOverflowTilesControl（Overflow 区域） ===== -->
	<Style x:Key="SidebarOverflowTilesControl" TargetType="ItemsControl">
		<Setter Property="FlowDirection" Value="RightToLeft" />
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel FlowDirection="RightToLeft" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ItemsControl">
					<StackPanel Orientation="Vertical" Background="{TemplateBinding Background}">
						<Control Style="{DynamicResource SidebarOverflowPartSplliter}" />
						<ItemsPresenter Margin="0,3,0,0" FlowDirection="{TemplateBinding FlowDirection}" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="24" Height="24" Template="{DynamicResource HalloweenOverflowIconTemplate}" />
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

