<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sidebar" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:snt="clr-namespace:Sidebar;assembly=Native">

	<!-- ===== Information ===== -->
	<s:String x:Key="ThemeDisplayName">Halloween</s:String>
	<s:String x:Key="ThemePublisherDisplayName">LongBar Project Group</s:String>
	<s:String x:Key="ThemeDescription">Halloween theme from LongBar.</s:String>
	<s:String x:Key="ThemeLogo">Gcds-Halloween-Jack-o-lantern.ico</s:String>

	<!-- ===== Options ===== -->
	<s:Boolean x:Key="EnableBlur">true</s:Boolean>
	<s:Boolean x:Key="EnableBlurForFlyout">true</s:Boolean>
	<s:Boolean x:Key="EnableBlurForDrag">true</s:Boolean>
	<s:Boolean x:Key="EnableNotificationBlur">true</s:Boolean>
	<s:Boolean x:Key="EnableNotificationClipRound">true</s:Boolean>

	<!-- ===== Global ===== -->
	<SolidColorBrush x:Key="GlobalForegroundBrush" Color="#ffc796" />
	<SolidColorBrush x:Key="GlobalFlyoutForegroundBrush" Color="#ffc796" />
	<s:Double x:Key="GlobalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSizeSmall">9</s:Double>

	<!-- ===== Sidebar ===== -->
	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="Transparent">
						<Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
							<Grid.RenderTransform>
								<ScaleTransform ScaleX="1" />
							</Grid.RenderTransform>
							<Border>
								<Border.Background>
									<LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
										<GradientStop Color="#B2c95402" Offset="0"/>
										<GradientStop Color="#cf321500" Offset="1"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<Border HorizontalAlignment="Left" Width="8">
								<Border.Background>
									<LinearGradientBrush EndPoint="1,0" StartPoint="0,0" MappingMode="RelativeToBoundingBox">
										<GradientStop Color="#00e55f02" Offset="1"/>
										<GradientStop Color="#FFe55f02" Offset="0"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
						</Grid>
						<Image Source="Images\pumpkins.png" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.5" />
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarHighlightSide" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Border HorizontalAlignment="Left" Width="2">
							<Border.Background>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Color="#DD8a3a00" Offset="0.0"/>
									<GradientStop Color="#DD8a3a00" Offset="0.5"/>
									<GradientStop Color="#CCe55f02" Offset="0.5"/>
									<GradientStop Color="#CCe55f02" Offset="1"/>
								</LinearGradientBrush>
							</Border.Background>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Taskbar Tray ===== -->
	<Style x:Key="SidebarTaskbarTrayBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="Transparent">
						<Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
							<Grid.RenderTransform>
								<ScaleTransform ScaleX="1" />
							</Grid.RenderTransform>
							<Border>
								<Border.Background>
									<LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
										<GradientStop Color="#B2c95402" Offset="0"/>
										<GradientStop Color="#cf321500" Offset="1"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<Border VerticalAlignment="Top" Height="8">
								<Border.Background>
									<LinearGradientBrush EndPoint="0,1" StartPoint="0,0" MappingMode="RelativeToBoundingBox">
										<GradientStop Color="#00e55f02" Offset="1"/>
										<GradientStop Color="#FFe55f02" Offset="0"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<Border VerticalAlignment="Top" Height="2">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#DD8a3a00" Offset="0.0"/>
										<GradientStop Color="#DD8a3a00" Offset="0.5"/>
										<GradientStop Color="#CCe55f02" Offset="0.5"/>
										<GradientStop Color="#CCe55f02" Offset="1"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
						</Grid>
						<Image Source="Images\pumpkins.png" Stretch="Uniform" VerticalAlignment="Stretch" HorizontalAlignment="Right" Opacity="0.3" Margin="0,2" />
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSystemIsTaskbarTopBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleY="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Sidebar Options ===== -->
	<Style x:Key="SidebarOptionsTop" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="17" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{DynamicResource UtilStringSidebarOptions}" />
							<Polygon Name="TopOptionsIcon" VerticalAlignment="Center" Points="0,0 3.5,3.5 7,0" Opacity="0.45" Stroke="#FDc95402" StrokeThickness="1" Fill="White" Margin="2,1,2,0" RenderTransformOrigin="0.556,0.9" SnapsToDevicePixels="True" UseLayoutRounding="True" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="OptionsBar" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="OptionsBar" Property="FlowDirection" Value="RightToLeft" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Splitters ===== -->
	<ControlTemplate x:Key="SidebarOptionsSplliterTemplate" TargetType="Control">
		<Border VerticalAlignment="Bottom" Height="2">
			<Border.Background>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Offset="0.0" Color="#CCe55f02" />
					<GradientStop Offset="1.0" Color="#00e55f02" />
				</LinearGradientBrush>
			</Border.Background>
		</Border>
	</ControlTemplate>
	<Style x:Key="SidebarOptionsSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="2" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,17,0,0" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>
	<Style x:Key="SidebarOverflowPartSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="2" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="FlowDirection" Value="LeftToRight" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>

	<!-- ===== Tile ===== -->
	<ControlTemplate x:Key="TileSplliterTemplate" TargetType="Control">
		<Grid x:Name="RootElement" RenderTransformOrigin="0.5,0.5">
			<Grid.RenderTransform>
				<ScaleTransform ScaleX="1" />
			</Grid.RenderTransform>
			<Border x:Name="Normal" VerticalAlignment="Bottom" Height="2">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#CCe55f02" />
						<GradientStop Offset="1.0" Color="#00e55f02" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<Border x:Name="Hover" VerticalAlignment="Bottom" Height="2" Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#FFffa040" />
						<GradientStop Offset="1.0" Color="#00ffa040" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
							<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
							<DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootElement" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="TileSplliter" TargetType="Thumb">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="Height" Value="4" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template" Value="{DynamicResource TileSplliterTemplate}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsPinned, ElementName=RootTileElement}" Value="True">
				<Setter Property="DockPanel.Dock" Value="Top" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileHeaderContainer" TargetType="Grid">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="FlyoutHeader" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal" Margin="2,0">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{DynamicResource UtilStringSidebarOptions}"></TextBlock>
							<Polygon Name="TopOptionsIcon" VerticalAlignment="Center" Points="0,0 3.5,3.5 7,0" Opacity="0.45" Stroke="#FDc95402" StrokeThickness="1" Fill="White" Margin="2,1,2,0" RenderTransformOrigin="0.556,0.9" SnapsToDevicePixels="True" UseLayoutRounding="True" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Height" Value="17" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

	<!-- ===== Flyout ===== -->
	<ControlTemplate x:Key="FlyoutBackgroundTemplate" TargetType="Control">
		<Grid>
			<Border x:Name="FlyoutBackgroundFill" Background="#c95402" Opacity="0.6" Margin="1" />
			<Border x:Name="FlyoutBorderBehind" BorderBrush="#ffc796" BorderThickness="1" />
		</Grid>
	</ControlTemplate>
	<Style x:Key="FlyoutBackground" TargetType="Control">
		<Setter Property="Template" Value="{DynamicResource FlyoutBackgroundTemplate}" />
	</Style>

	<!-- ===== Drag ===== -->
	<Style x:Key="DragWindowBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Grid>
							<Border Background="#c95402" Opacity="0.6" />
							<Border Background="Black" Opacity="0.1" />
							<Border BorderBrush="#BB000000" BorderThickness="1">
								<Border BorderBrush="#ffc796" BorderThickness="1" />
							</Border>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="DragWindowContentContainer" TargetType="Grid">
		<Setter Property="Margin" Value="10" />
	</Style>

	<!-- ===== Notification ===== -->
	<Style x:Key="NotificationBaseBackground" TargetType="Border">
		<Setter Property="Background" Value="#070707" />
		<Setter Property="CornerRadius" Value="5" />
	</Style>
	<Style x:Key="NotificationBackgroundHighlight" TargetType="Border">
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="#7EFFA040" />
					<GradientStop Offset="0.5" Color="#00FFA040" />
					<GradientStop Offset="0.95" Color="#00FFA040" />
					<GradientStop Offset="1" Color="#7EFFA040" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="OpacityMask">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#FFFFFFFF" />
					<GradientStop Offset="1" Color="#00FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationBorder" TargetType="Border">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="BorderBrush" Value="#e55f02" />
		<Setter Property="Margin" Value="0,15,0,0" />
	</Style>
	<Style x:Key="NotificationOptionsButton" TargetType="Button">
		<Setter Property="Width" Value="Auto" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<TextBlock x:Name="PART_TextBlock" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="#ffc796" Text="{DynamicResource UtilStringSidebarOptions}">
						<TextBlock.Effect>
							<DropShadowEffect x:Name="PART_Glow" BlurRadius="6" Opacity="0.6" ShadowDepth="0" Color="#e55f02" />
						</TextBlock.Effect>
					</TextBlock>
					<ControlTemplate.Triggers>
						<EventTrigger RoutedEvent="MouseEnter">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15" />
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="MouseLeave">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="BlurRadius" To="6" Duration="0:0:0.15" />
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="TouchEnter">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15" />
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="TouchLeave">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="BlurRadius" To="6" Duration="0:0:0.15" />
									<DoubleAnimation Storyboard.TargetName="PART_Glow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationTimeout" TargetType="Control">
		<Setter Property="Width" Value="5" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Margin" Value="0,-10,1,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<DockPanel>
						<Border Height="10" Background="#e55f02" DockPanel.Dock="Top">
							<Border.OpacityMask>
								<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
									<GradientStop Offset="0.0" Color="#00FFFFFF" />
									<GradientStop Offset="1.0" Color="#FFFFFFFF" />
								</LinearGradientBrush>
							</Border.OpacityMask>
						</Border>
						<Border Background="#e55f02" />
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationTitle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="Margin" Value="5,5,5,0" />
		<Setter Property="Foreground" Value="#ffc796" />
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect BlurRadius="6" Opacity="1" ShadowDepth="0" Color="Black" />
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationContent" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Margin" Value="5,3,5,5" />
		<Setter Property="Foreground" Value="#ffc796" />
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect BlurRadius="6" Opacity="1" ShadowDepth="0" Color="Black" />
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Icon Item brushes ===== -->
	<LinearGradientBrush x:Key="TileIconItemHoverBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="#4De55f02" />
		<GradientStop Offset="1" Color="#70733200" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="TileIconItemPressedBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="#39660000" />
		<GradientStop Offset="1" Color="#39994400" />
	</LinearGradientBrush>
	<SolidColorBrush x:Key="TileIconItemHoverBorderBrush" Color="#44ffc796" />
	<SolidColorBrush x:Key="TileIconItemPressedBorderBrush" Color="#47ffd6a0" />
	<LinearGradientBrush x:Key="TileIconItemWithTextHoverBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="#4De55f02" />
		<GradientStop Offset="1" Color="#70733200" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="TileIconItemWithTextPressedBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="#39660000" />
		<GradientStop Offset="1" Color="#39994400" />
	</LinearGradientBrush>
	<SolidColorBrush x:Key="TileIconItemWithTextHoverBorderBrush" Color="#44ffc796" />
	<SolidColorBrush x:Key="TileIconItemWithTextPressedBorderBrush" Color="#47ffd6a0" />

	<!-- ===== Icon Item 通用 Style ===== -->
	<Style x:Key="TileIconItemButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Padding" Value="4,4,4,4" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="1" Opacity="1">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<Storyboard />
								</VisualState>
