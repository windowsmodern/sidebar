<UserControl x:Class="WindowsModern.StickyNote.TilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:sbn="clr-namespace:Sidebar;assembly=Native"
             xmlns:local="clr-namespace:WindowsModern.StickyNote"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
			 Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
	<Grid Margin="10,3,9,1">
		<Button Name="FolderButtonHidden" Style="{DynamicResource TileStickyNoteFolderButton}" HorizontalAlignment="Left" Visibility="Hidden" VerticalAlignment="Top"></Button>
		<Popup Name="NewButtonPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=NewButton}" Placement="Left">
			<Border Style="{DynamicResource TileStickyNotePopupBackground}">
				<StackPanel Orientation="Horizontal">
					<Button Name="NewButtonYellow" Style="{DynamicResource TileStickyNotePopupNewButtonYellow}" Click="NewButton_CommandButtonClick"></Button>
					<Button Name="NewButtonRed" Style="{DynamicResource TileStickyNotePopupNewButtonRed}" Click="NewButton_CommandButtonClick"></Button>
					<Button Name="NewButtonGreen" Style="{DynamicResource TileStickyNotePopupNewButtonGreen}" Click="NewButton_CommandButtonClick"></Button>
					<Button Name="NewButtonBlue" Style="{DynamicResource TileStickyNotePopupNewButtonBlue}" Click="NewButton_CommandButtonClick"></Button>
					<Button Name="NewButtonWhite" Style="{DynamicResource TileStickyNotePopupNewButtonWhite}" Click="NewButton_CommandButtonClick"></Button>
				</StackPanel>
			</Border>
		</Popup>
		<Popup Name="SnipButtonPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=SnipButton}" Placement="Left">
			<Border Style="{DynamicResource TileStickyNotePopupBackground}">
				<StackPanel Orientation="Horizontal">
					<Button Name="SnipButtonFreeform" Style="{DynamicResource TileStickyNotePopupSnipButtonFreeform}" Click="SnipButton_CommandButtonClick"></Button>
					<Button Name="SnipButtonRect" Style="{DynamicResource TileStickyNotePopupSnipButtonRectangle}" Click="SnipButton_CommandButtonClick"></Button>
					<Button Name="SnipButtonWindow" Style="{DynamicResource TileStickyNotePopupSnipButtonWindow}" Click="SnipButton_CommandButtonClick"></Button>
					<Button Name="SnipButtonFull" Style="{DynamicResource TileStickyNotePopupSnipButtonFullScreen}" Click="SnipButton_CommandButtonClick"></Button>
				</StackPanel>
			</Border>
		</Popup>
		<DockPanel>
			<WrapPanel Name="ControlContentContainer" Orientation="Vertical" DockPanel.Dock="Left" Margin="0,0,4,0" SizeChanged="ControlContentContainer_SizeChanged">
				<sbn:FoldOptionsButton Name="NewButton" Style="{DynamicResource TileStickyNoteTileFoldButton}" CommandButtonContent="{DynamicResource TileStickyNoteNewButtonContent}" HorizontalAlignment="Left" Margin="0,0,0,1" OptionsButtonClick="NewButton_OptionsButtonClick" CommandButtonClick="NewButton_CommandButtonClick"></sbn:FoldOptionsButton>
				<sbn:FoldOptionsButton Name="SnipButton" Style="{DynamicResource TileStickyNoteTileFoldButton}" CommandButtonContent="{DynamicResource TileStickyNoteSnipButtonContent}" HorizontalAlignment="Left"  Margin="0,0,0,1" OptionsButtonClick="SnipButton_OptionsButtonClick" CommandButtonClick="SnipButton_CommandButtonClick"></sbn:FoldOptionsButton>
				<Button Name="FolderButton" Style="{DynamicResource TileStickyNoteFolderButton}" HorizontalAlignment="Left" Visibility="Collapsed"></Button>
			</WrapPanel>
			<Grid DockPanel.Dock="Right" Style="{DynamicResource TileStickyNoteTileNote}"></Grid>
		</DockPanel>
	</Grid>
</UserControl>
