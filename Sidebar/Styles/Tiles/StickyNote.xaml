	<Style x:Key="TileStickyNoteBubbleMenu" TargetType="Menu">
		<Setter Property="Height" Value="22"></Setter>
		<Setter Property="Margin" Value="45,0,0,1"></Setter>
		<Setter Property="VerticalAlignment" Value="Bottom"></Setter>
		<Setter Property="Background" Value="Transparent"></Setter>
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="10"></Setter>
	</Style>
	<Style x:Key="TileStickyNoteBubbleMenuItemDivider" TargetType="Image">
		<Setter Property="Stretch" Value="Fill"></Setter>
