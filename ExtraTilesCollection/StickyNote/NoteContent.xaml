<UserControl x:Class="WindowsModern.StickyNote.NoteContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.StickyNote"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
		<Image Name="ScreenshotContent"></Image>
		<RichTextBox Name="TextContent" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" TextChanged="TextContent_TextChanged"></RichTextBox>
		<InkCanvas Name="InkContent" Background="Transparent" StrokeCollected="InkContent_StrokeCollected"></InkCanvas>
	</Grid>
</UserControl>
