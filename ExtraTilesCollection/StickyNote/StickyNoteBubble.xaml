<Window x:Class="WindowsModern.StickyNote.StickyNoteBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.StickyNote"
			 xmlns:ptswc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme"
             mc:Ignorable="d" 
		Style="{DynamicResource TileStickyNoteBubbleWindow}"
		Background="Transparent" AllowsTransparency="True"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
		<HackImage Name="NoteBackground" Style="{DynamicResource TileStickyNoteBubbleBackground}"></HackImage>
		<DockPanel>
			<Grid Name="NoteHeader" DockPanel.Dock="Top">
				
			</Grid>
			<Grid Name="NoteRecordPart" DockPanel.Dock="Top">
				
			</Grid>
			<Grid Name="NoteSizer" DockPanel.Dock="Bottom">
				<Thumb Name="ThumbSizeChanger"></Thumb>
			</Grid>
			<Grid Name="NoteContent">
				<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
					<Grid>
						<Image Name="ScreenshotContent"></Image>
						<RichTextBox Name="TextContent"></RichTextBox>
						<InkCanvas Name="InkContent"></InkCanvas>
					</Grid>
				</ScrollViewer>
			</Grid>
		</DockPanel>
    </Grid>
</Window>
