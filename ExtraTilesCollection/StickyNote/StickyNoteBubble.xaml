<Window x:Class="WindowsModern.StickyNote.StickyNoteBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.StickyNote"
			 xmlns:ptswc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme"
             mc:Ignorable="d" 
		Style="{DynamicResource TileStickyNoteBubbleWindow}"
		Background="Transparent" AllowsTransparency="True"
		Loaded="Window_Loaded" Closed="Window_Closed" SourceInitialized="Window_SourceInitialized"
		SizeChanged="Window_SizeChanged" Activated="Window_Activated" Deactivated="Window_Deactivated"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
		<HackImage Name="NoteBackground" Style="{DynamicResource TileStickyNoteBubbleBackground}"></HackImage>
		<DockPanel>
			<Grid Name="NoteHeader" DockPanel.Dock="Top" Style="{DynamicResource TileStickyNoteBubbleHeader}">
				<TextBlock Name="NoteTitle" Style="{DynamicResource TileStickyNoteBubbleHeaderTitle}"></TextBlock>
				<Thumb Name="NoteHeaderThumb" Style="{DynamicResource TileStickyNoteHeaderThumb}" DragDelta="NoteHeaderThumb_DragDelta"></Thumb>
				<Button Name="AttachButton" Style="{DynamicResource TileStickyNoteBubbleHeaderAttachButton}"></Button>
				<Menu Name="NoteHeadMenu" Style="{DynamicResource TileStickyNoteBubbleMenu}">
					<MenuItem Name="ToolItem" Header="Tools"></MenuItem>
					<MenuItem Name="DividerItem">
						<MenuItem.Template>
							<ControlTemplate TargetType="MenuItem" >
								<Image x:Name="DividerImage" Style="{DynamicResource TileStickyNoteBubbleMenuItemDivider}" Source="{TemplateBinding Header}"></Image>
							</ControlTemplate>
						</MenuItem.Template>
					</MenuItem>
					<MenuItem Name="DeleteItem" Click="DeleteItem_Click" Style="{DynamicResource TileStickyNoteBubbleMenuItemImageItemDelete}"></MenuItem>
					<MenuItem Name="RecordItem" Click="RecordItem_Click" Style="{DynamicResource TileStickyNoteBubbleMenuItemImageItemRecord}"></MenuItem>
					<MenuItem Name="KbdPenItem" Click="KbdPenItem_Click" Style="{DynamicResource TileStickyNoteBubbleMenuItemImageItemKeyboard}"></MenuItem>
				</Menu>
				<Button Name="CloseButton" Style="{DynamicResource TileStickyNoteBubbleCloseButton}" Click="CloseButton_Click"></Button>
			</Grid>
			<Grid Name="NoteControlPart" DockPanel.Dock="Top">
				
			</Grid>
			<Grid Name="NoteSizer" DockPanel.Dock="Bottom">
				<Thumb Name="ThumbSizeChanger" Style="{DynamicResource TileStickyNoteBubbleResizeCornerThumb}" DragDelta="ThumbSizeChanger_DragDelta"></Thumb>
			</Grid>
			<Grid Name="NoteContent">
				<local:NoteContentPanel x:Name="ContentPanel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"></local:NoteContentPanel>
			</Grid>
		</DockPanel>
    </Grid>
</Window>
