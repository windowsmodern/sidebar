<Window x:Class="Sidebar.DragWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sidebar" Closed="Window_Closed"
		xmlns:pst="clr-namespace:Sidebar.Presentation"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Style="{DynamicResource DragWindowWindow}" ShowInTaskbar="False"
        Title="DragWindow" Height="300" Width="300" MinWidth="50" SourceInitialized="Window_SourceInitialized">
	<Grid Name="DragClientArea" Style="{DynamicResource DragWindowClientArea}">
		<Control Name="DragBackground" Style="{DynamicResource DragWindowBackground}"></Control>
		<Grid Name="TileTemplateContainer" Style="{DynamicResource DragWindowContentContainer}"></Grid>
		<Control Name="DragHighlight" Style="{DynamicResource DragWindowHighlight}"></Control>
	</Grid>
</Window>
