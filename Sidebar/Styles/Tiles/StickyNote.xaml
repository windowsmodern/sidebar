<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Sidebar"
					xmlns:snt="clr-namespace:Sidebar;assembly=Native"
					xmlns:pfswc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme"
					>
	<Style x:Key="TileStickyNoteTileFoldButtonOptionsPart" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Background="Transparent">
						<pfswc:HackImage x:Name="SplitArt" Source="..\..\Images\Sticky Note\SplitHoverImageID.png" HackThickness="3" DockPanel.Dock="Right" Opacity="0" pfswc:HackImageTransitions.Duration="0:0:0.15"/>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type snt:FoldOptionsButton}}}" Value="True">
							<Setter TargetName="SplitArt" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\SplitHoverImageID.png"/>
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="SplitArt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="SplitArt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="SplitArt" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\SplitDownImageID.png"/>
							<Trigger.EnterActions>
								<BeginStoryboard x:Name="PressedIn">
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="SplitArt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PressedIn"/>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="16"/>
		<Setter Property="Height" Value="23"/>
		<Setter Property="Padding" Value="0"/>
	</Style>
	<Style x:Key="TileStickyNoteTileFoldButtonCommandPart" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Background="Transparent">
						<pfswc:HackImage x:Name="MainArt" Source="..\..\Images\Sticky Note\ButtonHoverImageID.png" HackThickness="3" Opacity="0" pfswc:HackImageTransitions.Duration="0:0:0.15"/>
						<ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type snt:FoldOptionsButton}}}" Value="True">
							<Setter TargetName="MainArt" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\ButtonHoverImageID.png"/>
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="MainArt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="MainArt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="MainArt" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\ButtonDownImageID.png"/>
							<Trigger.EnterActions>
								<BeginStoryboard x:Name="PressedIn">
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="MainArt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PressedIn"/>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="MinWidth" Value="29"/>
		<Setter Property="Height" Value="23"/>
		<Setter Property="Padding" Value="0"/>
	</Style>
	<Style x:Key="TileStickyNoteTileFoldButton" TargetType="snt:FoldOptionsButton">
		<Setter Property="Width" Value="45"/>
		<Setter Property="Height" Value="23"/>
		<Setter Property="SnapsToDevicePixels" Value="True"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="snt:FoldOptionsButton">
					<DockPanel x:Name="Root">
						<Button x:Name="PART_OptionsButton" DockPanel.Dock="Right" Style="{TemplateBinding OptionsButtonStyle}" Content="{TemplateBinding OptionsButtonContent}"/>
						<Button x:Name="PART_CommandButton" DockPanel.Dock="Left" Style="{TemplateBinding CommandButtonStyle}" Content="{TemplateBinding CommandButtonContent}"/>
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileStickyNoteTileButton" TargetType="Button">
		<Setter Property="Width" Value="30"/>
		<Setter Property="Height" Value="23"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<pfswc:HackImage x:Name="Art" Source="..\..\Images\Sticky Note\ButtonNoPullrightHoverImageID.png" HackThickness="3" Opacity="0" pfswc:HackImageTransitions.Duration="0:0:0.15"/>
						<ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Art" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\ButtonNoPullrightHoverImageID.png"/>
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Art" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Art" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Art" Property="pfswc:HackImageTransitions.To" Value="..\..\Images\Sticky Note\ButtonNoPullrightDownImageID.png"/>
							<Trigger.EnterActions>
								<BeginStoryboard x:Name="PressedIn">
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Art" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PressedIn"/>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Grid x:Key="TileStickyNoteNewButtonContent" x:Shared="False">
		<Image>
			<Image.Style>
				<Style TargetType="Image">
					<Setter Property="Source" Value="..\..\Images\Sticky Note\NewButtonImageID.png"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
							<Setter Property="Source" Value="..\..\Images\Sticky Note\NewDownButtonImageID.png"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Image.Style>
		</Image>
	</Grid>
	<Grid x:Key="TileStickyNoteSnipButtonContent" x:Shared="False">
		<Image>
			<Image.Style>
				<Style TargetType="Image">
					<Setter Property="Source" Value="..\..\Images\Sticky Note\SnipButtonImageRestHoverID.png"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
							<Setter Property="Source" Value="..\..\Images\Sticky Note\SnipButtonImageDownID.png"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Image.Style>
		</Image>
	</Grid>
	<Style x:Key="TileStickyNoteFolderButton" TargetType="Button" BasedOn="{StaticResource TileStickyNoteTileButton}">
		<Setter Property="Content">
			<Setter.Value>
				<Image Source="..\..\Images\Sticky Note\FolderButtonRestHoverImageID.png"/>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Content">
					<Setter.Value>
						<Image Source="..\..\Images\Sticky Note\FolderButtonDownImageID.png"/>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileStickyNoteTileNote" TargetType="Grid">
		<Setter Property="Background">
			<Setter.Value>
				<SolidColorBrush Color="{DynamicResource TileStickyNoteFillDefault}"></SolidColorBrush>
			</Setter.Value>
		</Setter>
	</Style>
	
	<Color x:Key="TileStickyNoteFillYellow">#FBF7C8</Color>
	<Color x:Key="TileStickyNpteFillGreen">#D6F7D5</Color>
	<Color x:Key="TileStickyNoteFillBlue">#C3DCF7</Color>
	<Color x:Key="TileStickyNoteFillRed">#F5B7BD</Color>
	<Color x:Key="TileStickyNoteFillWhite">#FBFBFF</Color>
	<Color x:Key="TileStickyNoteFillDefault">#FBF7C8</Color>

	<Style x:Key="TileStickyNotePopupBackground" TargetType="Border">
		<Setter Property="Background" Value="White"></Setter>
		<Setter Property="BorderBrush" Value="#006400"></Setter>
		<Setter Property="BorderThickness" Value="2"></Setter>
	</Style>
	<Style x:Key="TileStickyNotePopupButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Background="Transparent">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"></Border>
						<Border x:Name="HoverBackground" Background="#2C000000" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" Opacity="0"></Border>
						<ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Background" Value="Transparent"></Setter>
		<Setter Property="BorderBrush" Value="Transparent"></Setter>
		<Setter Property="BorderThickness" Value="0"></Setter>
		<Setter Property="Width" Value="Auto"></Setter>
		<Setter Property="Height" Value="Auto"></Setter>
	</Style>
