	</Style>

	<Style x:Key="TileClockCalendarBorder" TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Width" Value="219" />
		<Setter Property="Height" Value="294" />
		<Setter Property="BorderBrush">
			<Setter.Value>
				<SolidColorBrush Color="{Binding BorderColor, Source={x:Static snow:SnowfallThemeProvider.Instance}}" />
			</Setter.Value>
		</Setter>
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="Background" Value="#F0FFFFFF" />
