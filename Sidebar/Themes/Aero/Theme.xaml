<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native"
	xmlns:ptswc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme">
	<!-- Infomation -->
	<s:String x:Key="ThemeDisplayName">Aero</s:String>
	<s:String x:Key="ThemePublisherDisplayName">Windows Modern</s:String>
	<s:String x:Key="ThemeDescription">Aero style in Windows Longhorn.</s:String>
	<s:String x:Key="ThemeLogo">Logo.jpg</s:String>
	<!--  Includes  -->
	<!--  Options  -->
	<s:Boolean x:Key="EnableBlur">true</s:Boolean>
	<s:Boolean x:Key="EnableNotificationBlur">false</s:Boolean>
	<s:Boolean x:Key="EnableNotificationClipRound">false</s:Boolean>
	<!--  Styles  -->
	<SolidColorBrush x:Key="GlobalForegroundBrush" Color="White" />
	<SolidColorBrush x:Key="GlobalFlyoutForegroundBrush" Color="White" />
	<s:Double x:Key="GlobalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSizeSmall">9</s:Double>

	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Border>
							<Border.Background>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Offset="0" Color="#99000000" />
									<GradientStop Offset="1" Color="#FF000000" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
						<Border HorizontalAlignment="Left" Width="200">
							<Border.Background>
								<RadialGradientBrush Center="-0.3,0.5" GradientOrigin="0.15,0.5" Opacity="0.08" RadiusX="0.5" RadiusY="0.9">
									<GradientStop Offset="0"    Color="#FFFFFFFF" />
									<GradientStop Offset="1"    Color="#00FFFFFF" />
									<GradientStop Offset="0.90" Color="#FFFFFFFF" />
								</RadialGradientBrush>
							</Border.Background>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarHighlightSide" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Border HorizontalAlignment="Left" Width="2">
							<Border.Background>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Offset="0.0" Color="#BB000000" />
									<GradientStop Offset="0.5" Color="#BB000000" />
									<GradientStop Offset="0.5" Color="#66FFFFFF" />
									<GradientStop Offset="1.0" Color="#66FFFFFF" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ControlTemplate x:Key="SidebarOptionsSplliterTemplate" TargetType="Control">
		<Grid x:Name="RootElement" Background="Transparent" RenderTransformOrigin="0.5,0.5">
			<Rectangle x:Name="TopLine" Height="1" VerticalAlignment="Top" Fill="Gray" Opacity="0.7">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#FF000000" />
						<GradientStop Offset="1.0" Color="#00000000" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
			<Rectangle x:Name="BottomLine" Height="1" VerticalAlignment="Bottom" Fill="Black" Opacity="0.7">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#FF000000" />
						<GradientStop Offset="1.0" Color="#00000000" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootElement" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="SidebarOptionsSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="2" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,17,0,0" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>
	<Style x:Key="SidebarOverflowPanelSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="2" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>
	<Style x:Key="SidebarOptionsTop" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{DynamicResource UtilStringSidebarOptions}"></TextBlock>
							<Grid Margin="2,0" VerticalAlignment="Center">
								<Image x:Name="TopOptionsIcon" Source="Images\OptionsNormal.png" Stretch="None"></Image>
								<Image x:Name="TopOptionsIconHover" Source="Images\OptionsHover.png" Opacity="0" Stretch="None"></Image>
							</Grid>
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="OptionsBar" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="OptionsBar" Property="FlowDirection" Value="RightToLeft" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Height" Value="17" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>
	<Style x:Key="SidebarTilesRegion" TargetType="DockPanel">
		<Setter Property="Margin" Value="0,19,0,0" />
	</Style>
	<Style x:Key="SidebarTaskbarTrayBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<ptswc:HackBorder x:Name="BackgroundImage" Source="Images\Taskbar.png" HackThickness="0,1,0,0" RenderTransformOrigin="0.5,0.5"></ptswc:HackBorder>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSystemIsTaskbarTopBinding}" Value="True">
							<Setter TargetName="BackgroundImage" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleY="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarMinRestoreButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<Image x:Name="Normal" Source="Images\RestoreNormal.png" />
						<Image x:Name="Hover" Source="Images\RestoreLight.png" Opacity="0" />
						<Image x:Name="Active" Source="Images\RestorePress.png" Opacity="0" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="17" />
		<Setter Property="Height" Value="27" />
		<Setter Property="VerticalAlignment" Value="Center"></Setter>
		<Setter Property="Margin" Value="6,0,6,0"></Setter>
		<Setter Property="DockPanel.Dock" Value="Left"></Setter>
	</Style>
	<Style x:Key="SidebarMinAeroPeekButton" TargetType="Button">
		<Setter Property="SnapsToDevicePixels" Value="True"></Setter>
		<Setter Property="Width" Value="1"></Setter>
		<Setter Property="DockPanel.Dock" Value="Right"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="PART_Btn" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_Btn" Property="Background" Value="#99FFFFFF"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PART_Btn" Property="Background" Value="#4DFFFFFF"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarMinTaskbarTilesControl" TargetType="ItemsControl">
		<Setter Property="SnapsToDevicePixels" Value="True"></Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="32" Margin="0,2,0,0">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid Background="Transparent">
									<Grid HorizontalAlignment="Right" VerticalAlignment="Top">
										<Image x:Name="NormalState" Source="Images\FlyoutNormal.png" Stretch="None"></Image>
										<Image x:Name="HoverState" Source="Images\FlyoutHover.png" Stretch="None" Opacity="0"></Image>
									</Grid>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverState" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverState" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarOverflowTilesControl" TargetType="ItemsControl">
		<Setter Property="FlowDirection" Value="RightToLeft"></Setter>
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel FlowDirection="RightToLeft"></WrapPanel>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ItemsControl">
					<StackPanel Orientation="Vertical" Background="{TemplateBinding Background}">
						<Control FlowDirection="LeftToRight" Style="{DynamicResource SidebarOverflowPanelSplliter}" />
						<ItemsPresenter Margin="0,3,0,0" FlowDirection="{TemplateBinding FlowDirection}"/>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="24" Height="24">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid FlowDirection="LeftToRight">
									<ptswc:HackImage x:Name="Hover" Source="Images\ItemHover.png" HackThickness="3" Opacity="0"></ptswc:HackImage>
									<ptswc:HackImage x:Name="Active" Source="Images\ItemActive.png" HackThickness="3" Opacity="0"></ptswc:HackImage>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="TileSplliterTemplate" TargetType="Thumb">
		<Grid x:Name="RootElement" Background="Transparent" RenderTransformOrigin="0.5,0.5">
			<Rectangle x:Name="TopLine" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="Gray" Opacity="0.7">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#FF000000" />
						<GradientStop Offset="1.0" Color="#00000000" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
			<Rectangle x:Name="BottomLine" Height="1" VerticalAlignment="Bottom" Fill="Black" Opacity="0.7">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0.0" Color="#FF000000" />
						<GradientStop Offset="1.0" Color="#00000000" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="TopLine" Property="OpacityMask">
					<Setter.Value>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Offset="0.0" Color="#FF000000" />
							<GradientStop Offset="1.0" Color="#AA000000" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
				<Setter TargetName="BottomLine" Property="OpacityMask">
					<Setter.Value>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Offset="0.0" Color="#FF000000" />
							<GradientStop Offset="1.0" Color="#AA000000" />
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
			</Trigger>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootElement" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="TileSplliter" TargetType="Thumb">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="Height" Value="4" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template" Value="{DynamicResource TileSplliterTemplate}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsPinned, ElementName=RootTileElement}" Value="True">
				<Setter Property="DockPanel.Dock" Value="Top" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileHeaderContainer" TargetType="Grid">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Style x:Key="TileFlyoutIcon" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Image x:Name="FlyoutIcon" Source="Images\FlyoutHover.png" VerticalAlignment="Top" IsHitTestVisible="True" RenderTransformOrigin="0.5,0.5" Cursor="Hand" AllowDrop="False" Margin="1,2,1,0" SnapsToDevicePixels="True" UseLayoutRounding="True" HorizontalAlignment="Right" Stretch="None"/>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="FlyoutIcon" Property="HorizontalAlignment" Value="Left"/>
							<Setter TargetName="FlyoutIcon" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" ScaleY="1"/>
								</Setter.Value>
							</Setter>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsPinned, ElementName=RootTileElement}" Value="True">
							<Setter Property="Margin" Value="1,4"/>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Opacity" Value="0"></Setter>
		<Setter Property="IsHitTestVisible" Value="False"></Setter>
	</Style>
	<Style x:Key="TileContentContainer" TargetType="Grid">
		<Setter Property="Margin" Value="1,0,0,0"></Setter>
		<Style.Triggers>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter Property="Margin" Value="0,0,1,0"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<ControlTemplate x:Key="FlyoutBackgroundTemplate" TargetType="Control">
		<Grid x:Name="BackgroundPart">
			<Border x:Name="FlyoutBorderBehind" BorderBrush="#802D2D2D" BorderThickness="1,1,0,1" />
			<Border x:Name="FlyoutBackgroundFill" Opacity="0.6" Margin="1,1,0,1" Background="Black" BorderBrush="LightGray" BorderThickness="1" />
			<Border x:Name="FlyoutBorder" Margin="1,1,0,1" BorderBrush="#800D0D0D" BorderThickness="1" />
			<Rectangle x:Name="FlyoutBackgroundHighlight" Opacity="0.9" Margin="-40,1,0,1">
				<Rectangle.Fill>
					<RadialGradientBrush Center="-0.5,0.5" GradientOrigin="0,0.5" Opacity="1" RadiusX="0.8" RadiusY="2">
						<GradientStop Offset="1" Color="#00FFFFFF" />
						<GradientStop Offset="0.99" Color="#19FFFFFF" />
						<GradientStop Offset="0.49" Color="#00FFFFFF" />
						<GradientStop Offset="0.5" Color="#B2A9A9A9" />
					</RadialGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
		</Grid>
	</ControlTemplate>
	<Style x:Key="FlyoutBackground" TargetType="Control">
		<Setter Property="Template" Value="{DynamicResource FlyoutBackgroundTemplate}"></Setter>
	</Style>
	<Style x:Key="FlyoutHeader" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{DynamicResource UtilStringSidebarOptions}"></TextBlock>
							<Grid Margin="4,0" VerticalAlignment="Center">
								<Image x:Name="TopOptionsIcon" Source="Images\OptionsNormal.png" Stretch="None"></Image>
								<Image x:Name="TopOptionsIconHover" Source="Images\OptionsHover.png" Opacity="0" Stretch="None"></Image>
							</Grid>
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
