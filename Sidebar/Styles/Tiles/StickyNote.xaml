	<Style x:Key="TileStickyNoteBubbleWindow" TargetType="Window">
		<Setter Property="WindowStyle" Value="None"></Setter>
		<Setter Property="Width" Value="306"></Setter>
		<Setter Property="Height" Value="231"></Setter>
		<Setter Property="MinWidth" Value="190"></Setter>
		<Setter Property="MinHeight" Value="43"></Setter>
	</Style>
	<Style x:Key="TileStickyNoteBubbleBackground" TargetType="HackImage">
		<Setter Property="HackThickness" Value="45,43,17,17"></Setter>
		<Setter Property="Source" Value="{DynamicResource TileStickyNoteBubbleBackgroundSticky}"></Setter>
	</Style>
	<ImageSource x:Key="TileStickyNoteBubbleBackgroundSticky">..\..\Images\Sticky Note\Bubble\Sticky.png</ImageSource>
	<ImageSource x:Key="TileStickyNoteBubbleBackgroundFlatSticky">..\..\Images\Sticky Note\Bubble\FlatSticky.png</ImageSource>
	<Style x:Key="TileStickyNoteBubbleHeader" TargetType="Grid">
